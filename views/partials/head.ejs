    .icon {
      display: inline-flex;
      align-items: center;
      color: #4596de;
      width: 22px;
      height: 22px;
    }

    .icon svg {
      width: 22px;
      height: 22px;
    }

    .delete {
      fill: red;
    }

    .download {
      fill: green;
    }
    .nothing-container {
      display: flex;
      justify-content: center;
      align-items: center;
      color: gray;
      padding-top: 100px;
    }
    label {
      font-weight: 700;
    }
    .title-design {
