    rel="stylesheet"
  />
  <style>
    /* 1. Use a more-intuitive box-sizing model */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    /* 2. Remove default margin */
    *:not(dialog) {
      margin: 0;
    }

    /* 3. Enable keyword animations */
    @media (prefers-reduced-motion: no-preference) {
      html {
        interpolate-size: allow-keywords;
      }
    }

    body {
      /* 4. Increase line-height */
      line-height: 1.5;
      /* 5. Improve text rendering */
      -webkit-font-smoothing: antialiased;
    }

    /* 6. Improve media defaults */
    img,
    picture,
    video,
    canvas,
    svg {
      display: block;
      max-width: 100%;
    }

    /* 7. Inherit fonts for form controls */
    input,
    button,
    textarea,
    select {
      font: inherit;
    }

    /* 8. Avoid text overflows */
    p,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      overflow-wrap: break-word;
    }

    /* 9. Improve line wrapping */
    p {
      text-wrap: pretty;
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      text-wrap: balance;
    }

    /*
  10. Create a root stacking context
*/
    #root,
    #__next {
      isolation: isolate;
    }

    /*End of reset*/
    html {
      height: 100vh;
    }
    body {
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Oxygen,
        Ubuntu,
        Cantarell,
        "Open Sans",
        "Helvetica Neue",
        sans-serif;
      background-color: #f8f9fa;
    }
    header {
      display: flex;
      justify-content: space-between;
      padding: 10px 40px;
      background-color: white;
    }
    a {
      color: grey;
    }
    .message {
      margin: 10px 200px;
      padding: 20px;
      border: 1px solid black;
      border-radius: 10px;
    }
    .message p {
      font-size: 1.25rem;
    }
    .message h2 {
      color: red;
    }

    .message-details {
      display: flex;
      justify-content: space-between;
      padding: 10px 100px;
    }
    .date {
      color: gray;
    }
    .date p {
      font-size: 0.8rem;
    }
    form {
      display: grid;
      gap: 20px;
      max-width: 328px;
    }
    label {
      min-width: 100px;
    }
    input {
      min-width: 300px;
      border-radius: 10px;
      padding: 10px;
    }
    .form-item {
      width: 200px;
      display: flex;
      justify-content: space-between;
    }
    form button {
      width: 100px;
      font-size: 1.5rem;
      padding: 10px;
      border-radius: 10px;
      color: white;
      background-color: red;
    }
    nav {
      display: flex;
      gap: 40px;
      align-items: center;
    }
    .heading {
      display: flex;
      justify-content: space-between;
      padding: 10px 200px;
    }
    .create-post {
      background-color: inherit;
      font-weight: 800;
      color: rgb(52, 102, 238);
      font-size: larger;
      border: none;
    }
    .create-post:active {
      transform: translateY(2px);
    }
    .logo {
      font-family: "Google Sans";
      color: #4596de;
      text-decoration: none;
    }
    nav a {
      font-size: 1.2rem;
      font-weight: 800;
      color: black;
      text-decoration: none;
    }
    h2:active {
      transform: translateY(2px);
    }
    .dialog-form {
